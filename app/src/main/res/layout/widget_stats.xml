<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_fog"
            android:tint="@color/ember" />
        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Unfog"
            android:textColor="@color/mist_dim"
            android:textSize="12sp" />
        <ImageView
            android:id="@+id/rec_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Overall stats, shown when no trip is running. -->
    <LinearLayout
        android:id="@+id/idle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:text="0.00"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="10dp"
            android:text="km² unfogged"
            android:textColor="@color/ember"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp">
                <TextView
                    android:id="@+id/stat_trips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/mist"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/stat_trips_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="trips"
                    android:textColor="@color/mist_dim"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp">
                <TextView
                    android:id="@+id/stat_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/mist"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/stat_km_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="km"
                    android:textColor="@color/mist_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp">
                <TextView
                    android:id="@+id/stat_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/mist"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/stat_days_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="days"
                    android:textColor="@color/mist_dim"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp">
                <TextView
                    android:id="@+id/stat_photos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/mist"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/stat_photos_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="photos"
                    android:textColor="@color/mist_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Live view of the trip in progress. -->
    <LinearLayout
        android:id="@+id/active"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:text="0.0"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />
        <TextView
            android:id="@+id/distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="10dp"
            android:text="km so far"
            android:textColor="@color/ember"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="9dp">
            <Chronometer
                android:id="@+id/elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mist"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="on the road"
                android:textColor="@color/mist_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp">
                <TextView
                    android:id="@+id/trip_photos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/mist"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/trip_photos_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="photos"
                    android:textColor="@color/mist_dim"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="9dp">
                <TextView
                    android:id="@+id/trip_started"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="00:00"
                    android:textColor="@color/mist"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/trip_started_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="started"
                    android:textColor="@color/mist_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_button_start"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Start trip"
        android:textColor="#FF2A1100"
        android:textSize="13sp" />
</LinearLayout>
